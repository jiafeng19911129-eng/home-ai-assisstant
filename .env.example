# GEMINI_API_KEY: Required for Gemini AI API calls (Express Backend / Cloud Run / Docker)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Used for frontend direct Gemini API calls (GitHub Pages / Static SPA)
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000

