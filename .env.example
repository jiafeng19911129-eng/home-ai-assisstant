# GEMINI_API_KEY: Required for Gemini AI API calls (Express Backend / Cloud Run / Docker)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Used for frontend direct Gemini API calls (GitHub Pages / Static SPA)
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000

# Google Firebase Cloud Sync (Optional, can also be pasted directly in Settings Modal UI)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_APP_ID=""

